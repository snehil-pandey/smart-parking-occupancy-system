# Park Here local setup
# Copy provider-specific values into your Firebase generated config files.
# Do not commit real API keys or service credentials.

PARK_HERE_MAP_PROVIDER=local
PARK_HERE_FIREBASE_PROJECT_ID=your-firebase-project-id
PARK_HERE_ANDROID_APP_ID=your-android-app-id
PARK_HERE_IOS_APP_ID=your-ios-app-id
PARK_HERE_WEB_APP_ID=your-web-app-id

